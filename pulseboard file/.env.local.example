# Salin file ini menjadi .env.local untuk development di komputer sendiri.
# Untuk deploy, isi 3 variabel yang sama ini di Vercel > Project Settings > Environment Variables.

# Email service account Google Cloud (akun robot, BUKAN gmail pribadimu)
# Contoh: pulseboard-bot@nama-project-123456.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key dari file JSON service account (bagian "private_key").
# Tempel APA ADANYA termasuk -----BEGIN PRIVATE KEY----- dan -----END PRIVATE KEY-----
# Biarkan \n tetap sebagai teks \n (dua karakter), jangan diubah jadi baris baru asli.
GOOGLE_PRIVATE_KEY=

# ID Google Sheet, diambil dari URL:
# https://docs.google.com/spreadsheets/d/INI_ADALAH_SHEET_ID/edit
GOOGLE_SHEET_ID=
